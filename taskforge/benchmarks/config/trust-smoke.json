{
  "name": "trust-smoke",
  "description": "Fast end-to-end validation of the TF-012B trust pipeline; not a capacity baseline.",
  "minimum_public_trials": 3,
  "required_blocks": 3,
  "required_public_scenarios": [
    "noop_scaling",
    "io50_scaling",
    "cpu_scaling",
    "api_throughput",
    "arrival_saturation",
    "retry_storm",
    "recovery_storm"
  ],
  "random_seed": 12012,
  "trial_cv_threshold": 0.50,
  "between_block_drift_threshold": 0.50,
  "cooldown_seconds": 0.1,
  "warmup_tasks": 20,
  "scaling_workers": [1, 4],
  "noop_tasks": 100,
  "io_tasks": 40,
  "cpu_tasks": 40,
  "cpu_iterations": 20000,
  "api_requests": 100,
  "api_concurrency": [1, 10],
  "arrival_rates": [25, 100],
  "arrival_seconds": 2,
  "saturation_workers": 4,
  "retry_tasks": 30,
  "retry_workers": 4,
  "recovery_tasks": 20,
  "recovery_workers": 4,
  "recovery_kill_percentage": 50,
  "recovery_sleep_ms": 1000
}
