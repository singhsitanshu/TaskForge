POSTGRES_PASSWORD=taskforge
POSTGRES_PORT=5432

REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=taskforge

SCHEDULER_RECOVERY_INTERVAL=5s
