SCHEDULER_RETRY_PROMOTION_INTERVAL=1s
SCHEDULER_RETRY_PROMOTION_BATCH_SIZE=100
SCHEDULER_RETRY_PROMOTION_DB_TIMEOUT=2s
SCHEDULER_METRICS_INTERVAL=5s
SCHEDULER_METRICS_DB_TIMEOUT=2s

WORKER_HEARTBEAT_INTERVAL=5s
WORKER_STALE_AFTER=15s
WORKER_DEAD_AFTER=30s
